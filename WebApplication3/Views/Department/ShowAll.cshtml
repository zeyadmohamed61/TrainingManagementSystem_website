@model List<Department>

<h1>Departments</h1>
<table class="table table-bordered">
    <thead>
        <tr><th>ID</th><th>Name</th><th>Manager</th><th></th><th></th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Manager</td>
                <td><a href="/Department/Details/@item.Id" class="btn btn-primary">Details</a></td>
                <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a></td>
                <td>
                    <form asp-controller="Department" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this department?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/Department/Add" class="btn btn-success mb-3">Add New Department</a>