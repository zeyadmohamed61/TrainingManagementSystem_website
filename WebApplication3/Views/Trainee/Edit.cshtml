@model TraineeDeptViewModel

<h1>Edit @Model.Name</h1>

<form asp-action="SaveEdit" asp-controller="Trainee" method="post">
    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
    </div>

    <div>
        <label asp-for="Image"></label>
        <input class="form-control" asp-for="Image" />
    </div>

    <div>
        <label asp-for="PhoneNumber"></label>
        <input class="form-control" asp-for="PhoneNumber" />
    </div>

    <div>
        <label asp-for="Grade"></label>
        <input class="form-control" asp-for="Grade" />
    </div>

    <div>
        <label>Department</label>
        <select name="DepartmentId" class="form-control">
            @foreach (var dept in Model.DepartmentList)
            {
                if (Model.DepartmentId == dept.Id)
                {
                    <option value="@dept.Id" selected>@dept.Name</option>
                }
                else
                {
                    <option value="@dept.Id">@dept.Name</option>
                }
            }
        </select>
    </div>

    <button type="submit" class="btn btn-success mt-2">
        Save
    </button>

    <a asp-action="ShowAll" asp-controller="Trainee">Back To List</a>
    <a asp-action="Details" asp-controller="Trainee" asp-route-id="@Model.Id">Go To Trainee Details</a>
</form>